# PokéRescue Sentinel Desktop Client Environment Template
# Note: Sensitive secrets must NEVER be committed or baked into client builds.

# Backend API endpoint (future local Rust service or remote gateway)
VITE_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Real-time WebSocket / SSE endpoint (future event stream)
VITE_REALTIME_WS_URL=ws://127.0.0.1:8080/events

# App configuration mode: DEVELOPMENT | SIMULATION | PRODUCTION
VITE_APP_MODE=DEVELOPMENT

# Feature flags (all default to disabled in scaffold)
VITE_ENABLE_EXPERIMENTAL_SENSING=false
VITE_ENABLE_VOICE_GUIDANCE=false
